+void Voxel_mapping::load_external_poses()
+{
+    std::ifstream input( m_external_pose_path );
+    if ( !input )
+        throw std::runtime_error( "Cannot open external pose file: " + m_external_pose_path );
+
+    string line;
+    while ( std::getline( input, line ) )
+    {
+        if ( line.empty() )
+            continue;
+        std::istringstream stream( line );
+        double value[ 12 ];
+        for ( int i = 0; i < 12; ++i )
+        {
+            if ( !( stream >> value[ i ] ) )
+                throw std::runtime_error( "External pose file must contain 12 values per line: " + m_external_pose_path );
+        }
+        M3D rotation;
+        rotation << value[ 0 ], value[ 1 ], value[ 2 ], value[ 4 ], value[ 5 ], value[ 6 ], value[ 8 ], value[ 9 ], value[ 10 ];
+        m_external_pose_rotations.push_back( rotation );
+        m_external_pose_positions.emplace_back( value[ 3 ], value[ 7 ], value[ 11 ] );
+    }
+    if ( m_external_pose_positions.empty() )
+        throw std::runtime_error( "External pose file is empty: " + m_external_pose_path );
+    ROS_INFO( "Loaded %zu fixed external poses from %s", m_external_pose_positions.size(), m_external_pose_path.c_str() );
+}
