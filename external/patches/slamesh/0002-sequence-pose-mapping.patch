 Parameter param;//parameters
 Log g_data;//global variables

+static std::vector<Transf> loadExternalPoses(const std::string &path){
+    std::ifstream input(path);
+    if(!input){
+        throw std::runtime_error("Can not open external pose file: " + path);
+    }
+    std::vector<Transf> poses;
+    std::string line;
+    while(std::getline(input, line)){
+        if(line.empty()) continue;
+        std::istringstream stream(line);
+        double value[12];
+        for(int i = 0; i < 12; ++i){
+            if(!(stream >> value[i])){
+                throw std::runtime_error("External pose file must contain 12 values per line: " + path);
+            }
+        }
+        Transf pose = Transf::Identity();
+        pose << value[0], value[1], value[2], value[3],
+                value[4], value[5], value[6], value[7],
+                value[8], value[9], value[10], value[11],
+                0, 0, 0, 1;
+        poses.push_back(pose);
+    }
+    if(poses.empty()){
+        throw std::runtime_error("External pose file is empty: " + path);
+    }
+    return poses;
+}
